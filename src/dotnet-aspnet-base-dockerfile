FROM mcr.microsoft.com/dotnet/aspnet:10.0

# The services declare a HEALTHCHECK that probes /hc with curl, which is not
# part of the aspnet runtime image. Without it every healthcheck fails with
# "curl: not found" and containers are permanently reported as unhealthy.
RUN apt-get -y update \
    && apt-get install -y --no-install-recommends curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
